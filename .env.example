# 이 파일을 .env.local로 복사해서 값을 채우세요. .env.local은 깃에 올라가지 않아요.

# Supabase 대시보드 > Project Settings > API
# 로컬 개발은 `npm run db:start` 실행 후 나오는 값을 쓰면 돼요.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 않기). 손님 주문 넣기, 알림 발송 기록처럼 서버에서만 하는 일에 써요.
# 없으면 손님 주문이 들어가지 않아요. 로컬은 npm run setup이 채워줘요.
SUPABASE_SECRET_KEY=

# 주문 횟수 제한에 쓰는 IP 해시의 소금. 비워두면 SUPABASE_SECRET_KEY를 써요.
ORDER_HASH_SALT=

# SMS 발송 대행사 (발신번호 등록 후 채우기)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=

# 알림 문자에 들어갈 주문 조회 링크의 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 랜딩 페이지 "신청하기" 버튼이 열 주소 (카카오톡 채널, 구글 폼 등). 비워두면 버튼 대신 안내 문구가 보여요.
NEXT_PUBLIC_CONTACT_URL=

# 새 주문 웹 푸시 알림 키. npm run setup이 로컬용으로 만들어줘요.
# 배포할 땐 npx web-push generate-vapid-keys 로 새로 만들어 넣어요. 비공개 키는 NEXT_PUBLIC_ 붙이지 않기.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kkotpick@users.noreply.github.com
