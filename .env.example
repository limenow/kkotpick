# 이 파일을 .env.local로 복사해서 값을 채우세요. .env.local은 깃에 올라가지 않아요.

# Supabase 대시보드 > Project Settings > API
# 로컬 개발은 `npm run db:start` 실행 후 나오는 값을 쓰면 돼요.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 않기). 알림 발송 기록 같은 RLS 우회 작업에만 써요.
SUPABASE_SECRET_KEY=

# SMS 발송 대행사 (발신번호 등록 후 채우기)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=

# 알림 문자에 들어갈 주문 조회 링크의 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000
